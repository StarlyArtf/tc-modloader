/* Resources of the installer executable.

   The loader that gets deployed is embedded here (the player downloads one
   file), the version block is what Explorer shows, and the manifest carries the
   per-monitor V2 DPI awareness and the asInvoker execution level - the window
   asks for administrator rights only when the target directory needs it.

   build.ps1 generates build/setup-version.rc (VERSIONINFO, from VERSION) and
   compiles this file with -Ibuild -Isrc. */

#include <windows.h>

101 RCDATA "../dist/tc-loader.dll"

/* The window, taskbar and Explorer icon.  Generated by tools/make-icon.ps1 and
   kept in the tree so a build needs no drawing tool. */
100 ICON "../assets/tc-modloader.ico"

1 24 "setup-manifest.xml"

#include "setup-version.rc"
